{
  "name": "proved",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proved — paid on proof. Symmetric verifiable settlement for cross-border service work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhiBao/proved.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contract": "cd contracts/proved && stellar contract build",
    "test:contract": "cd contracts/proved && cargo test",
    "deploy:testnet": "node --env-file-if-exists=.env.local scripts/deploy.mjs --network testnet",
    "deploy:mainnet": "node --env-file-if-exists=.env.local scripts/deploy.mjs --network mainnet",
    "demo:testnet": "node --env-file-if-exists=.env.local scripts/demo.mjs --network testnet",
    "open:testnet": "node --env-file-if-exists=.env.local scripts/open-job.mjs",
    "walk": "node --env-file-if-exists=.env.local scripts/walk.mjs",
    "verify": "node --env-file-if-exists=.env.local scripts/verify.mjs",
    "proof": "node --env-file-if-exists=.env.local scripts/mainnet-proof.mjs",
    "keys": "node --env-file-if-exists=.env.local scripts/keys.mjs",
    "sync-env": "node --env-file-if-exists=.env.local scripts/sync-env.mjs",
    "dev": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "check": "pnpm run build:contract && pnpm run test:contract && pnpm run build:web"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  }
}
