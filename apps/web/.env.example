# Copy to .env.local. Testnet values are filled in by `node scripts/sync-env.mjs`.

NEXT_PUBLIC_NETWORK=testnet

# The deployed Proved contract for this network
NEXT_PUBLIC_CONTRACT_TESTNET=
NEXT_PUBLIC_CONTRACT_MAINNET=

# Soroban RPC. Testnet has a public default; mainnet needs a provider.
NEXT_PUBLIC_RPC_TESTNET=
NEXT_PUBLIC_RPC_MAINNET=

# Settlement asset. On testnet we mint our own (a 7-decimal classic asset);
# on mainnet this is Circle's USDC (6-decimal).
NEXT_PUBLIC_ASSET_CODE_TESTNET=PUSD
NEXT_PUBLIC_ASSET_CONTRACT_TESTNET=
NEXT_PUBLIC_USDC_MAINNET=
